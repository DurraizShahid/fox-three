[gd_resource type="Resource" script_class="SongProfile" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/music/song_profile.gd" id="1_song"]
[ext_resource type="Script" path="res://scripts/music/music_section.gd" id="2_sec"]
[ext_resource type="Script" path="res://scripts/music/important_moment.gd" id="3_mom"]
[ext_resource type="Script" path="res://scripts/music/stage_theme.gd" id="4_theme"]
[ext_resource type="Resource" path="res://resources/themes/sunset_canyon.tres" id="5_theme_res"]

